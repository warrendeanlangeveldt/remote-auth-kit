{
  "manifest_version": 3,
  "name": "Login Relay",
  "version": "0.2.0",
  "description": "Fills logins you approve on your phone into this Chrome. Values are end-to-end encrypted to this extension; Claude never receives them.",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "Login Relay", "default_popup": "options.html" },
  "permissions": ["storage", "scripting", "tabs", "webNavigation", "alarms"],
  "host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"]
}
